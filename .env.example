# ==============================================================================
# PLANTILLA MAESTRA DE DESPLIEGUE SINGLE-TENANT WHITE-LABEL (EAM / CMMS)
# ==============================================================================
# Copiar este archivo a .env en la raíz del monorepo y completar antes de desplegar.
# NUNCA subir .env con secretos reales a control de versiones.

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (Docker Compose o PostgreSQL / Supabase externo)
# ------------------------------------------------------------------------------
POSTGRES_DB=eam_platform
POSTGRES_USER=eam_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# En Docker Compose usa host "postgres"; en Supabase usa pooler (:6543) y DIRECT_URL (:5432)
DATABASE_URL=postgresql://eam_admin:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/eam_platform?schema=public
DIRECT_URL=postgresql://eam_admin:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/eam_platform?schema=public

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y CRIPTOGRAFÍA (Generar valores aleatorios >= 32 caracteres)
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_HEX_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRATION=7d
AUTH_SECRET=CHANGE_ME_RANDOM_HEX_NEXTAUTH_SECRET_AT_LEAST_32_CHARS
AUTH_TRUST_HOST=true
CONFIG_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_AES_KEY_AT_LEAST_32_CHARS

# ------------------------------------------------------------------------------
# 3. IDENTIDAD DE INSTANCIA Y PUERTOS
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=Mi Plataforma EAM
APP_SLUG=eam-platform
APP_WEBSITE=https://eam.miempresa.com
APP_CONTACT_EMAIL=soporte@miempresa.com

API_PORT=3000
ADMIN_PORT=3001
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Mi Plataforma EAM
INTERNAL_API_URL=http://api:3000/api
NEXTAUTH_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. SEMBRADO INICIAL IDEMPOTENTE (Primer arranque en BD vacía)
# ------------------------------------------------------------------------------
RUN_SEED=true
# ALL o subconjunto separado por comas: V1,V2,V3,V4,V5,V6,V7,V8
SEED_PRESETS=ALL
SEED_ORG_NAME=Mi Organización EAM
SEED_ORG_RAZON_SOCIAL=Mi Organización S.A.S.
SEED_ORG_TAX_TYPE=NIT
SEED_ORG_CITY=Bogotá
SEED_ORG_COUNTRY=Colombia
SEED_ORG_ISO=CO
SEED_ORG_TIMEZONE=America/Bogota
SEED_ORG_LOCALE=es-CO
SEED_ORG_CURRENCY=USD
SEED_ORG_CURRENCY_SYMBOL=$
SEED_ORG_DECIMALS=2
SEED_ORG_TAX_LABEL=IVA
SEED_ORG_TAX_RATE=19

# Bootstrap del primer usuario administrador (omitir si ya existe BD migrada)
SEED_ADMIN_EMAIL=admin@miempresa.com
SEED_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_DOC=ADMIN-0001

# ------------------------------------------------------------------------------
# 5. MOTOR PDF (Chromium preinstalado en contenedor)
# ------------------------------------------------------------------------------
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ------------------------------------------------------------------------------
# 6. INTEGRACIONES OPCIONALES (Storage S3/R2, Cloudinary, SMTP, Supabase Realtime)
# ------------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
