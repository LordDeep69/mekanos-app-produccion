# ==============================================================================
# EAM PLATFORM API - PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Copiar a apps/api/.env y completar con valores reales antes de ejecutar.

# Application & White-Label
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_NAME=Mi Plataforma EAM API
APP_SLUG=eam-api
APP_WEBSITE=https://eam.miempresa.com
APP_CONTACT_EMAIL=soporte@miempresa.com

# PostgreSQL / Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/eam_platform?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/eam_platform?schema=public

# JWT & Secrets Encryption (>= 32 chars aleatorios en producción)
JWT_SECRET=CHANGE_ME_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_HEX_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRATION=7d
CONFIG_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_AES_KEY_AT_LEAST_32_CHARS

# CORS ('*' o lista separada por comas de orígenes permitidos)
CORS_ORIGIN=http://localhost:3001

# Puppeteer / PDF
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# En Linux Docker suele ser /usr/bin/chromium; en desarrollo dejar vacío si usa Chrome local
# PUPPETEER_EXECUTABLE_PATH=

# Storage & Email (Opcionales según despliegue; SMTP también se puede gestionar desde Admin UI)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=

# Supabase Realtime / Storage (Opcional)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
